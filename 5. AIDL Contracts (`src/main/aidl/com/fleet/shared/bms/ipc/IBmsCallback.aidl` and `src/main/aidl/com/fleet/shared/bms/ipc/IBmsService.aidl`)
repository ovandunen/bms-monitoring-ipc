package com.fleet.shared.bms.ipc;

import android.os.Parcelable;

interface IBmsCallback extends Parcelable {
    void onStateChanged(in ParcelableBatterySnapshot snapshot);
    void onConnectionStatusChanged(int statusCode);
    void onLocationChanged(in ParcelableVehicleLocation location); // new method
}

interface IBmsService extends Parcelable {
    ParcelableBatterySnapshot getCurrentSnapshot();
    ParcelableVehicleLocation getCurrentLocation(); // new method
    void registerCallback(IBmsCallback callback);
    void unregisterCallback(IBmsCallback callback);
    void sendCommand(in ParcelableBmsCommand command);
}
