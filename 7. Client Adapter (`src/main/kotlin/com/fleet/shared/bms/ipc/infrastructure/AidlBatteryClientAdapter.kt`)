    ...
    
    inner class IBmsCallback : IBmsCallback.Stub() { // same as before, but with new onLocationChanged method
        override fun onLocationChanged(location: ParcelableVehicleLocation) {
            val domain = VehicleLocationMapper.toDomain(location)
            _vehicleLocation.value = domain
        }
    }
    
    ...
    
    private fun refreshSnapshotFromService() {
        // same as before, but with getCurrentLocation instead of getCurrentSnapshot
        val parcel = service?.currentLocation 
        if (parcel != null && parcel.timestamp != 0L) {
            _vehicleLocation.value = VehicleLocationMapper.toDomain(parcel)
        }
    }
